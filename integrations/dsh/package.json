{
  "name": "dsh-notifyhub",
  "version": "0.2.0",
  "description": "Feishu completion notifications and desktop session continuation for DeepSeek Harness and Codex.",
  "author": "oldtommmy",
  "contributors": ["OpenAI Codex"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldtommmy/notifyhub.git",
    "directory": "integrations/dsh"
  },
  "homepage": "https://github.com/oldtommmy/notifyhub#readme",
  "bugs": {
    "url": "https://github.com/oldtommmy/notifyhub/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "feishu",
    "lark",
    "codex"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "package.json",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.1.5-0 || >=0.2.2-rc.5 <0.2.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
