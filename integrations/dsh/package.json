{
  "name": "dsh-notifyhub",
  "version": "0.1.0",
  "description": "Feishu private-chat notifications for DeepSeek Harness turns.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldtommmy/notifyhub.git",
    "directory": "integrations/dsh"
  },
  "homepage": "https://github.com/oldtommmy/notifyhub#readme",
  "bugs": {
    "url": "https://github.com/oldtommmy/notifyhub/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "feishu",
    "lark",
    "codex"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "package.json",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.1.5-0"
  },
  "publishConfig": {
    "access": "public"
  }
}